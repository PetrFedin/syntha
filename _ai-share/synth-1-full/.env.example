# Synth-1 — local development (copy to .env.local)
NEXT_PUBLIC_RUNWAY_DATA_SOURCE=api

# Public product / investor brief.
# Set NEXT_PUBLIC_INVESTORS_URL to a stable branded /investors URL before printing QR.
# If empty, the page uses the current browser origin + /investors.
NEXT_PUBLIC_INVESTORS_URL=

# Optional CTA. Supports https:// and mailto:. Hidden when empty.
NEXT_PUBLIC_INVESTOR_CONTACT_URL=
