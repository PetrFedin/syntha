{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/app/brand/*": ["./src/app/brand/*", "./_archive/brand-longtail/src/app/brand/*"],
      "@/app/shop/*": ["./src/app/shop/*", "./_archive/shop-longtail/src/app/shop/*"],
      "@/app/b/*": ["./src/app/b/*", "./_archive/brand-public/src/app/b/*"],
      "@/*": ["./src/*"],
      "@/lib/client/*": ["./_archive/client-b2c/src/lib/client/*"],
      "@/components/client/*": ["./_archive/client-b2c/src/components/client/*"],
      "@/components/wardrobe/*": ["./_archive/client-b2c/src/components/wardrobe/*"],
      "@/components/shop/b2b": ["./_archive/b2b-advanced/src/components/shop/b2b/index.ts"],
      "@/components/shop/b2b/*": ["./_archive/b2b-advanced/src/components/shop/b2b/*"],
      "@/components/b2b/*": ["./_archive/b2b-advanced/src/components/b2b/*"],
      "@/components/brand/b2b": ["./_archive/b2b-advanced/src/components/brand/b2b/index.ts"],
      "@/components/brand/b2b/*": ["./_archive/b2b-advanced/src/components/brand/b2b/*"],
      "@/app/brand/b2b/*": ["./_archive/b2b-advanced/src/app/brand/b2b/*"],
      "@/app/admin/*": ["./_archive/experiments/src/app/admin/*"],
      "@/components/academy/*": ["./_archive/experiments/src/components/academy/*"],
      "@/components/admin": ["./_archive/experiments/src/components/admin/index.ts"],
      "@/components/admin/*": ["./_archive/experiments/src/components/admin/*"],
      "@/components/vendor/*": ["./_archive/experiments/src/components/vendor/*"],
      "@/components/distributor/*": ["./_extended/distributor/src/components/distributor/*"],
      "@/components/*": ["./src/components/*"],
      "@/providers/*": ["./src/providers/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/ai/*": ["./src/ai/*"]
    }
  },
  "include": [
    "*.config.cts",
    "*.config.mjs",
    "*.config.ts",
    ".next-e2e/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "_archive/client-b2c/**/*.ts",
    "_archive/client-b2c/**/*.tsx",
    "_archive/b2b-advanced/**/*.ts",
    "_archive/b2b-advanced/**/*.tsx",
    "_archive/experiments/**/*.ts",
    "_archive/experiments/**/*.tsx",
    "_archive/brand-longtail/**/*.ts",
    "_archive/brand-longtail/**/*.tsx",
    "_archive/shop-longtail/**/*.ts",
    "_archive/shop-longtail/**/*.tsx",
    "_archive/brand-public/**/*.ts",
    "_archive/brand-public/**/*.tsx",
    "_extended/**/*.ts",
    "_extended/**/*.tsx",
    "tailwind.config.ts",
    ".next-isolated/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "backup_duplicates",
    "components",
    ".next",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
