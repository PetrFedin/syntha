# Enable server bootstrap in Next.js instrumentation.
SYNTHA_COMMERCIAL_EXECUTION_ENABLED=false

# PostgreSQL. The deployment image must include the pg package.
SYNTHA_DATABASE_URL=postgresql://user:password@localhost:5432/syntha
SYNTHA_DATABASE_SSL_MODE=disable
SYNTHA_DATABASE_POOL_MAX=10
SYNTHA_DATABASE_IDLE_TIMEOUT_MS=30000
SYNTHA_DATABASE_CONNECTION_TIMEOUT_MS=10000

# Scoped server credentials. No unrestricted legacy token is accepted.
# Example:
# [{"credentialId":"org-a-operator","token":"replace-with-at-least-24-characters","organizations":["ORG-A"],"permissions":["read","operate","worker","schedule"]},{"credentialId":"scheduler","token":"replace-with-another-long-token","organizations":["*"],"permissions":["scheduler"]}]
SYNTHA_OPERATIONS_CREDENTIALS_JSON=[]

# Signing keys are scoped by organization and integration.
# Example:
# [{"keyId":"current","organizationId":"ORG-A","integrationId":"erp","secret":"replace-with-at-least-16-characters"}]
SYNTHA_INTEGRATION_SIGNING_KEYS_JSON=[]

# Example transport:
# [{"integrationId":"erp","endpoint":"https://erp.example.com/api/orders","bearerToken":"secret","timeoutMs":10000}]
SYNTHA_INTEGRATION_TRANSPORTS_JSON=[]

SYNTHA_INTEGRATION_WORKER_ID=syntha-commercial-worker
SYNTHA_INTEGRATION_WORKER_MAX_COMMANDS=100
