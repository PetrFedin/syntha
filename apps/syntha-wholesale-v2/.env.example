# Server-only commercial execution runtime.
# The concrete PostgreSQL driver is composed outside the domain module.
SYNTHA_DATABASE_URL=postgresql://user:password@localhost:5432/syntha

# Minimum 24 characters. Used only by the internal operations API.
SYNTHA_OPERATIONS_API_TOKEN=replace-with-a-long-random-server-token

# JSON array. Store real values in the deployment secret manager, never in git.
# Example:
# [{"keyId":"current","integrationId":"erp","secret":"replace-with-at-least-16-characters","activeFrom":"2026-07-01T00:00:00.000Z"}]
SYNTHA_INTEGRATION_SIGNING_KEYS_JSON=[]

SYNTHA_INTEGRATION_WORKER_ID=syntha-commercial-worker
SYNTHA_INTEGRATION_WORKER_MAX_COMMANDS=100
