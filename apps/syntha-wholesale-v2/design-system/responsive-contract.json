  "templates": {
    "registry": ["PageHeader","Toolbar","SummaryStrip","TableOrGrid","Pagination"],
    "entity": ["Breadcrumb","EntityHeader","Tabs","MainContent","Inspector"],
    "builder": ["SourceRail","WorkSurface","SummaryInspector","ValidationBar"],
    "showroom": ["MinimalHeader","PresentationCanvas","SelectionTray","ProductInspector"],
    "dealSpace": ["ConversationList","Thread","ContextInspector"]
  },
