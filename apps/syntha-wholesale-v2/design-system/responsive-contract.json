    "cardMinDesktop": 208,
    "cardMinMobile": 156,
    "columns390": 2,
    "columns768": 3,
    "columns1024": 4,
    "columns1280": 4,
    "columns1440": 5,
    "columns1920": 6
  },
  "showroom": {
    "desktop": {"header": 64, "heroVh": [60,75], "productInspector": 420, "selectionTray": "right-or-bottom"},
    "iPad": {"layout": "image-first", "inspector": "drawer", "selectionTray": "bottom-panel"},
    "iPhone": {"layout": "single-column", "productGridColumns": 2, "productDetail": "fullscreen", "selectionAction": "sticky-bottom"}
  },
  "orderBuilder": {
    "desktop": {"topBar": 56, "sourceRail": 256, "sourceRailRange": [240,280], "matrixMin": 640, "summary": 352, "summaryRange": [320,380], "statusBar": 40},
    "matrix": {"productHeader": 48, "colourRow": 40, "sizeHeader": 36, "quantityCell": [44,40], "stickyIdentity": 240},
    "iPad": {"modes": ["Products","Order","Summary"], "visibleWorkAreas": 1, "totalsBar": true},
    "iPhone": {"fullMatrix": false, "steps": ["Products","Quantities","Delivery","Review"], "persistentSummary": ["units","value","validation","review"]}
